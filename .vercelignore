# Vercel Ignore File
# Files and directories to exclude from deployment

# Development files
node_modules
.git
.gitignore
.env.local
.env.development

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
src/test/
coverage/

# Documentation (optional - remove if you want to deploy docs)
*.md
!README.md

# Scripts
scripts/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (will be rebuilt)
dist-ssr/
*.local

# TypeScript
*.tsbuildinfo

# Large media files (served via external links)
public/works/*.mov
public/works/*.m4v
public/works/*.aif
public/works/*.mp3

# Misc
.kiro/
